// Numeric types, casts, bitwise operators, chars, bool (Documents 4, 5).
fn main() {
    let a: i64 = 100;
    let f: f64 = a as f64 / 8.0;
    println(f);
    let t: u8 = (300 as i32) as u8;
    println(t);
    let neg: i32 = -17;
    println(neg % 5);
    println(neg / 5);
    println(7 & 3);
    println(7 | 8);
    println(5 ^ 1);
    println(1 << 10);
    let zero: u8 = 0;
    println(~zero as i32);
    println(2 ** 10);
    println(true && !false);
    println('A');
    println('é');
    println(3.5f32 * 2.0f32);
    let big: u64 = 18446744073709551615;
    println(big);
    let lo: i8 = -128;
    println(lo as i32);
    println(255 as i32 as u8 as char);
}
