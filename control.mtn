// Diverging control flow: loops that return, all-branches-return, panic tails, early return, nested tuples, strings.
fn forever(n: i32) -> i32 {
    loop {
        if n > 0 { return n; }
        return -n;
    }
}
fn all_return(n: i32) -> i32 {
    if n > 0 { return 1; } else { return 2; }
}
fn ends_in_panic(n: i32) -> i32 {
    if n > 0 { return n; }
    panic("negative");
}
fn nested(n: i32) -> i32 {
    let r = match n {
        0 => { return 100; }
        1 => 5,
        _ => { if n > 10 { return 200; } n }
    };
    r + 1
}
fn unit_fn(n: i32) {
    if n > 0 { return; }
    println("nonpositive");
}
fn cmp3(a: f64, b: f64) -> i32 {
    if a < b { -1 } else if a > b { 1 } else { 0 }
}
fn main() {
    println(forever(-3));
    println(all_return(1) + all_return(0));
    println(ends_in_panic(4));
    println(nested(0)); println(nested(1)); println(nested(5)); println(nested(50));
    unit_fn(1); unit_fn(0);
    println(cmp3(1.0, 2.0)); println(cmp3(2.5, 2.5));
    let t = (1, (2, 3));
    println(t.1.0 + t.1.1);
    let mut k = 0;
    let mut total = 0;
    while k < 10 {
        k += 1;
        if k % 2 == 0 { continue; }
        total += k;
    }
    println(total);
    let s = "héllo";
    println(s);
    print("a"); print(1); print('x'); println(true);
    eprintln("to stderr");
}
