// try / catch / throw (Document 11 §3), lowered by desugaring to Result + match.
enum ConfigError {
    Missing,
    Invalid(i32),
}

fn read_value(key: i32) -> Result<i32, ConfigError> {
    if key == 0 {
        return Err(ConfigError::Missing);
    }
    Ok(key * 10)
}

fn parse_value(v: i32) -> Result<i32, ConfigError> {
    if v > 100 {
        return Err(ConfigError::Invalid(v));
    }
    Ok(v + 1)
}

fn load(key: i32) -> i32 {
    let outcome = try {
        let raw = read_value(key)?;
        let parsed = parse_value(raw)?;
        parsed
    } catch (e) {
        match e {
            ConfigError::Missing => -1,
            ConfigError::Invalid(v) => -v,
        }
    };
    outcome
}

fn guarded(x: i32) -> i32 {
    try {
        if x < 0 {
            throw ConfigError::Invalid(x);
        }
        println(x);
    } catch (e) {
        println(-999);
    }
    x
}

fn main() {
    println(load(3));
    println(load(0));
    println(load(50));
    println(guarded(7));
    println(guarded(-4));
}
