trait Shape { fn area(borrow self) -> i32; }
struct Sq { side: i32 }
impl Shape for Sq { fn area(borrow self) -> i32 { return self.side; } }
struct Rcy { r: Rc<i32> }
impl Shape for Rcy { fn area(borrow self) -> i32 { return 1; } }

fn main() { let b: Box<dyn Shape + Send> = Box::new(Rcy { r: Rc::new(1) }); println(b.area()); }
