// Loops (Document 9 §3): loop-with-value, while, for over ranges, labels, do/while.
fn main() {
    let mut i = 0;
    let result = loop {
        i += 1;
        if i == 10 {
            break i * 2;
        }
    };
    println(result);

    let mut count = 0;
    while count < 3 {
        println(count);
        count += 1;
    }

    let mut sum = 0;
    for k in 1..=5 {
        sum += k;
    }
    println(sum);

    'outer: for a in 0..5 {
        for b in 0..5 {
            if b == 3 { continue 'outer; }
            if a == 2 { break 'outer; }
            println(a * 10 + b);
        }
    }

    let mut n = 0;
    do {
        n += 1;
    } while (n < 4);
    println(n);
}
