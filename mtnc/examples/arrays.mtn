// Fixed arrays [T; N], slices &[T], bounds-checked indexing (Document 5 §3.1).
const SIZE: usize = 4;

fn sum(xs: &[i32]) -> i32 {
    let mut total = 0;
    let mut i: usize = 0;
    while i < 4 {
        total += xs[i];
        i += 1;
    }
    total
}

fn first_two(xs: &[i32]) -> i32 {
    xs[0] * 100 + xs[1]
}

fn bump_all(borrow mut a: [i32; SIZE]) {
    let mut i: usize = 0;
    while i < SIZE {
        a[i] += 1;
        i += 1;
    }
}

fn main() {
    let mut a: [i32; 4] = [10, 20, 30, 40];
    println(a[0] + a[3]);
    a[1] = 25;
    a[2] += 5;
    println(sum(borrow a));
    bump_all(borrow mut a);
    println(a[0]);
    println(first_two(borrow a[1..3]));
    let grid: [[i32; 2]; 2] = [[1, 2], [3, 4]];
    println(grid[1][0]);
    let words: [char; 3] = ['a', 'b', 'c'];
    println(words[2]);
    let tail = borrow a[2..=3];
    println(tail[0]);
    println(tail[1]);
    let idx: usize = 7;
    println(a[idx]);
}
