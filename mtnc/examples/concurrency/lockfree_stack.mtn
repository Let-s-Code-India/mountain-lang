// Treiber stack with a tagged pointer against ABA (Document 14 §4, §5, §9.6), written in Mountain on
// Atomic<usize>, raw pointers, alloc/dealloc and Arc. No compiler or runtime support beyond Phase 13 atomics.
//
// TAGGED WORD. Document 14 §5 asks for "a generation counter packed alongside the pointer, compared
// atomically as one word". One Atomic<usize> holds both: the low 48 bits are the node address (user-space
// addresses on x86-64 and aarch64 Linux fit in 47 bits; `check_address` asserts it for every node), the high
// 16 bits are the tag. EVERY successful change of a list head bumps the tag (TAG_STEP), so a head word that
// looked the same earlier but was changed in between (pop A, pop B, push A) now differs in the tag and the
// stale compareAndSwap fails. The tag wraps after 65,536 changes; an ABA then needs exactly that many head
// changes to happen between one thread's load and its CAS (the usual limit of tagged pointers, documented).
//
// MEMORY RECLAMATION. A popped node is never freed while the stack lives: it goes onto the stack's own free
// list (a second tagged Treiber list) and the next push reuses it. So a node's memory stays valid for any
// thread that still holds its address (a stale pop reads `next` of a node that was popped meanwhile, and its
// CAS then fails on the tag), which makes every read safe: no use-after-free. Everything is freed when the
// stack is dropped (Drop walks both lists), after all threads are done with it (Arc guarantees that).
//
// MEMORY ORDERINGS (each one, and why it is enough):
//  * head.load(Acquire): pairs with the Release half of the AcqRel CAS of the push that published the node, so
//    the node's `value` and `next` writes are visible before we use them.
//  * node.next.store(.., Relaxed) before the push CAS: it is only made visible to others by the CAS that
//    follows (Release), so it needs no ordering of its own.
//  * node.next.load(Relaxed) in pop: the Acquire load of head already made the push's write visible. If the
//    node was popped and re-pushed in the meantime, we may read a newer `next`; then head changed too (tag),
//    and our CAS fails. A stale `next` is never used on success. `next` is an atomic so these concurrent
//    reads and writes are not a data race.
//  * head.compareAndSwap(.., AcqRel): Release publishes the node (value + next) to the next Acquire loader;
//    Acquire (on success) makes the previous pusher's writes visible to the popper that now owns the node.
//    The failure ordering derived from AcqRel is Acquire, which is what the retry's fresh load needs anyway.
//  * The value of a node is written before the push CAS and read after the pop CAS by the one thread that
//    won it: the CAS pair (Release/Acquire) orders them, so the plain value access is not a race.
const TAG_STEP: usize = 1;
const PTR_MASK: usize = 281474976710655; // 2^48 - 1
const TAG_MASK: usize = 65535;

struct Node<T> { next: Atomic<usize>, value: T }

// what a pop saw before its CAS: the head word and the `next` of the top node
struct Snapshot { word: usize, next: usize }

fn check_address(p: usize) -> usize {
    if p > PTR_MASK { panic("lock-free stack: address does not fit in 48 bits"); }
    p
}

fn pack(ptr: usize, tag: usize) -> usize { ((tag & TAG_MASK) << 48) | ptr }

fn tag_of(word: usize) -> usize { word >> 48 }

fn ptr_of(word: usize) -> usize { word & PTR_MASK }

// push an existing node onto the list whose head is `head` (a tagged word)
fn list_push<T>(head: borrow Atomic<usize>, n: *mut Node<T>) {
    let addr = check_address(n as usize);
    loop {
        let cur = head.load(Ordering::Acquire);
        unsafe { (*n).next.store(ptr_of(cur), Ordering::Relaxed); }
        if head.compareAndSwap(cur, pack(addr, tag_of(cur) + TAG_STEP), Ordering::AcqRel).isOk() { return; }
    }
}

// the first half of a pop: look at the top. `word` 0 pointer part means empty.
fn list_snapshot<T>(head: borrow Atomic<usize>) -> Snapshot {
    let cur = head.load(Ordering::Acquire);
    let p = ptr_of(cur);
    if p == 0 { return Snapshot { word: cur, next: 0 }; }
    let node = p as *mut Node<T>;
    let nx = unsafe { (*node).next.load(Ordering::Relaxed) };
    Snapshot { word: cur, next: nx }
}

// the second half: replace the top by its successor if the head word is still exactly what we saw
fn list_commit<T>(head: borrow Atomic<usize>, s: borrow Snapshot) -> bool {
    head.compareAndSwap(s.word, pack(s.next, tag_of(s.word) + TAG_STEP), Ordering::AcqRel).isOk()
}

// pop the top node, or a null pointer when the list is empty
fn list_pop<T>(head: borrow Atomic<usize>) -> *mut Node<T> {
    loop {
        let s = list_snapshot::<T>(head);
        let p = ptr_of(s.word);
        if p == 0 { return 0 as usize as *mut Node<T>; }
        if list_commit::<T>(head, borrow s) { return p as *mut Node<T>; }
    }
}

// `marker` is never used. The two heads are plain words, so without it `T` would not appear in the type's
// fields and the compiler could not tell that a stack of non-Send values (an Rc, say) must not cross threads.
// `Atomic<*mut Node<T>>` is Send + Sync exactly when T is Send (Document 14 §9.4), which gives the right rule.
struct LockFreeStack<T> { head: Atomic<usize>, free: Atomic<usize>, marker: Atomic<*mut Node<T>> }

impl<T> LockFreeStack<T> {
    fn new() -> LockFreeStack<T> {
        LockFreeStack { head: Atomic::new(0), free: Atomic::new(0), marker: Atomic::new(0 as usize as *mut Node<T>) }
    }

    fn push(borrow self, value: T) {
        unsafe {
            let mut n = list_pop::<T>(borrow self.free);
            if n.isNull() {
                n = alloc(sizeOf::<Node<T>>(), alignOf::<Node<T>>()) as *mut Node<T>;
            }
            let vp = &mut (*n).value as *mut T;
            vp.write(value);
            list_push::<T>(borrow self.head, n);
        }
    }

    fn pop(borrow self) -> Option<T> {
        unsafe {
            let n = list_pop::<T>(borrow self.head);
            if n.isNull() { return None; }
            let vp = &mut (*n).value as *mut T;
            let v = vp.read();
            list_push::<T>(borrow self.free, n);
            Some(v)
        }
    }
}

impl<T> Drop for LockFreeStack<T> {
    fn drop(borrow mut self) {
        unsafe {
            // values still on the stack are dropped, then every node of both lists is freed
            loop {
                let n = list_pop::<T>(borrow self.head);
                if n.isNull() { break; }
                let vp = &mut (*n).value as *mut T;
                dropInPlace(vp);
                dealloc(n as *mut u8, sizeOf::<Node<T>>(), alignOf::<Node<T>>());
            }
            loop {
                let n = list_pop::<T>(borrow self.free);
                if n.isNull() { break; }
                dealloc(n as *mut u8, sizeOf::<Node<T>>(), alignOf::<Node<T>>());
            }
        }
    }
}

fn new_node(v: i64) -> *mut Node<i64> {
    unsafe {
        let n = alloc(sizeOf::<Node<i64>>(), alignOf::<Node<i64>>()) as *mut Node<i64>;
        let vp = &mut (*n).value as *mut i64;
        vp.write(v);
        n
    }
}

fn value_of(n: *mut Node<i64>) -> i64 { unsafe { (*n).value } }

// The classic ABA sequence, run on the raw list so the interleaving is exact:
//   list A -> B -> C; thread 1 looks at the top (A, next B) and is "preempted";
//   thread 2 pops A, pops B, pushes A back (now A -> C);
//   thread 1 resumes and tries its CAS.
// With the tag the CAS fails and the list stays A -> C. Without it (TAG_STEP = 0, which only the test does)
// the CAS succeeds and installs B, a node thread 2 already popped, as the top: the list becomes B -> C, so A is
// lost and B (whose value thread 2 already took) is handed out a second time.
// Returns the sum of what is left on the list, then how many nodes it holds, as `sum * 10 + count`.
fn aba_sequence() -> i64 {
    let head: Atomic<usize> = Atomic::new(0);
    let a = new_node(1);
    let b = new_node(20);
    let c = new_node(300);
    list_push::<i64>(borrow head, c);
    list_push::<i64>(borrow head, b);
    list_push::<i64>(borrow head, a);
    let stale = list_snapshot::<i64>(borrow head);
    // thread 2
    let p1 = list_pop::<i64>(borrow head);
    let p2 = list_pop::<i64>(borrow head);
    list_push::<i64>(borrow head, p1);
    // thread 1 resumes
    let committed = list_commit::<i64>(borrow head, borrow stale);
    // read out what the list holds now
    let mut sum: i64 = 0;
    let mut count: i64 = 0;
    let mut guard: i64 = 0;
    let mut cur = ptr_of(head.load(Ordering::Acquire));
    while cur != 0 && guard < 10 {
        let n = cur as *mut Node<i64>;
        sum = sum + value_of(n);
        count = count + 1;
        guard = guard + 1;
        cur = unsafe { (*n).next.load(Ordering::Relaxed) };
    }
    println(committed);
    unsafe {
        dealloc(a as *mut u8, sizeOf::<Node<i64>>(), alignOf::<Node<i64>>());
        dealloc(b as *mut u8, sizeOf::<Node<i64>>(), alignOf::<Node<i64>>());
        dealloc(c as *mut u8, sizeOf::<Node<i64>>(), alignOf::<Node<i64>>());
    }
    sum * 10 + count
}

fn hammer(s: Arc<LockFreeStack<i64>>, id: i64, n: i64) -> i64 {
    let mut k: i64 = 0;
    let mut got: i64 = 0;
    while k < n {
        s.push(id * 1000000 + k);
        match s.pop() {
            Some(v) => { got = got + v; }
            None => { got = got + 0; }
        }
        k = k + 1;
    }
    got
}

fn main() {
    let s: LockFreeStack<i64> = LockFreeStack::new();
    s.push(1);
    s.push(2);
    s.push(3);
    println(match s.pop() { Some(v) => v, None => -1 });
    println(match s.pop() { Some(v) => v, None => -1 });
    s.push(4);
    println(match s.pop() { Some(v) => v, None => -1 });
    println(match s.pop() { Some(v) => v, None => -1 });
    println(match s.pop() { Some(v) => v, None => -1 });

    println(aba_sequence());

    let shared: Arc<LockFreeStack<i64>> = Arc::new(LockFreeStack::new());
    let c1 = shared.clone();
    let c2 = shared.clone();
    let c3 = shared.clone();
    let c4 = shared.clone();
    let t1 = thread::spawnOS(move || hammer(c1, 1, 20000));
    let t2 = thread::spawnOS(move || hammer(c2, 2, 20000));
    let t3 = thread::spawnOS(move || hammer(c3, 3, 20000));
    let t4 = thread::spawnOS(move || hammer(c4, 4, 20000));
    let mut total = t1.join() + t2.join() + t3.join() + t4.join();
    // every push is matched by one pop, so what the threads popped plus what is left is everything pushed
    loop {
        match shared.pop() {
            Some(v) => { total = total + v; }
            None => { break; }
        }
    }
    println(total);
}
