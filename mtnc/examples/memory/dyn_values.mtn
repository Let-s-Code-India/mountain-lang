// `dyn Trait` as a VALUE type is an owned trait object = Box<dyn Trait> (Doc 7 §4.5, Doc 8 §6, Doc 3 F, Doc 11 §6).
// Interpretation recorded in PROGRESS (manager decision, Phase 11c).
trait Drawable {
    fn draw(borrow self) -> i32;
}

struct Button { id: i32 }
struct Image { name: String, w: i32 }
struct Label { text: String }

impl Drawable for Button { fn draw(borrow self) -> i32 { return self.id; } }
impl Drawable for Image { fn draw(borrow self) -> i32 { return self.w * 10; } }
impl Drawable for Label { fn draw(borrow self) -> i32 { return 100; } }

trait Failure {
    fn code(borrow self) -> i32;
    fn cause(borrow self) -> Option<borrow dyn Failure>;
}

struct Inner { c: i32 }
struct Outer { c: i32, inner: Inner }

impl Failure for Inner {
    fn code(borrow self) -> i32 { return self.c; }
    fn cause(borrow self) -> Option<borrow dyn Failure> { return None; }
}
impl Failure for Outer {
    fn code(borrow self) -> i32 { return self.c; }
    fn cause(borrow self) -> Option<borrow dyn Failure> { return Some(borrow self.inner); }
}

fn render(shape: dyn Drawable) -> i32 { return shape.draw(); }

fn renderAll(shapes: [dyn Drawable], n: i32) -> i32 {
    let mut i = 0;
    let mut total = 0;
    while i < n {
        total = total + shapes[i].draw();
        i = i + 1;
    }
    return total;
}

fn main() {
    // different concrete types behind one trait, in one growable array; each is dropped through its vtable
    let shapes: [dyn Drawable] = [Button { id: 1 }, Image { name: String::from("logo"), w: 3 }, Label { text: String::from("hi") }];
    println(renderAll(shapes, 3));
    // a by-value `dyn Drawable` parameter takes a concrete value (implicitly boxed)
    println(render(Image { name: String::from("pic"), w: 2 }));
    println(render(Button { id: 7 }));
    // `Option<borrow dyn Failure>`: a nullable fat reference
    let e = Outer { c: 5, inner: Inner { c: 9 } };
    match e.cause() {
        Some(c) => println(c.code()),
        None => println(0),
    }
    let i = Inner { c: 4 };
    match i.cause() {
        Some(c) => println(c.code()),
        None => println(-1),
    }
}
