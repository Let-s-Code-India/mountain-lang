// Owned values are released on every way out of a scope: `return`, `break`, `continue` and `?`.
struct Token { text: String }

fn parse(n: i32) -> Result<Token, i32> {
    if n < 0 { return Err(n); }
    return Ok(Token { text: String::from("tok") });
}

fn first_big(limit: i32) -> i32 {
    let guard = String::from("guard");
    let mut i = 0;
    while i < 10 {
        let scratch = String::from("scratch");
        if i == 2 { i = i + 1; continue; }
        if i * i > limit { return i; }
        i = i + 1;
    }
    return -1;
}

fn through_question(n: i32, m: i32) -> Result<i32, i32> {
    let held = String::from("held");
    let a = parse(n)?;
    let b = parse(m)?;
    println(a.text);
    println(b.text);
    return Ok(1);
}

fn break_out() -> i32 {
    let mut total = 0;
    let mut i = 0;
    loop {
        let item = String::from("item");
        i = i + 1;
        if i > 4 { break; }
        total = total + i;
    }
    return total;
}

fn main() {
    println(first_big(20));
    println(break_out());
    match through_question(1, 2) { Ok(v) => println(v), Err(e) => println(e) }
    match through_question(1, -7) { Ok(v) => println(v), Err(e) => println(e) }
    match through_question(-3, 2) { Ok(v) => println(v), Err(e) => println(e) }
}
