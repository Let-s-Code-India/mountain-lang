// Rc clone/drop counts, Weak upgrade and the parent <-> child cycle broken by Weak (Doc 6 §6).
struct Leaf { name: String }
struct Parent { name: String, kid: Option<Rc<Child>> }
struct Child { name: String, parent: Option<Weak<Parent>> }

fn main() {
    let w: Weak<Leaf>;
    {
        let r = Rc::new(Leaf { name: String::from("leaf") });
        w = r.downgrade();
        println(Rc::strongCount(borrow r));
        println(Rc::weakCount(borrow r));
        let r2 = r.clone();
        println(Rc::strongCount(borrow r));
        println(r2.name);
        match w.upgrade() {
            Some(x) => println(Rc::strongCount(borrow x)),
            None => println(0),
        }
        println(Rc::strongCount(borrow r));
    }
    match w.upgrade() {
        Some(x) => println(1),
        None => println(0),
    }

    let p = Rc::new(Parent { name: String::from("p"), kid: None });
    let c = Rc::new(Child { name: String::from("c"), parent: Some(p.downgrade()) });
    println(Rc::strongCount(borrow p));
    println(Rc::weakCount(borrow p));
    println(c.name);
    match c.parent {
        Some(pw) => match pw.upgrade() {
            Some(pp) => println(pp.name),
            None => println(0),
        },
        None => println(0),
    }
}
