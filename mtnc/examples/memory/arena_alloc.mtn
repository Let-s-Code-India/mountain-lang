// A user-written bump (arena) allocator implementing `Allocator` (Doc 13 §3.2) and boxes placed in it.
// `Box<T, A>` frees through ITS allocator; for an arena `dealloc` is a no-op and the whole arena is
// released at once with `release`.
struct Arena {
    base: *mut u8,
    cap: usize,
    offset: usize,
    live: usize,
}

impl Arena {
    fn new(cap: usize) -> Arena {
        unsafe {
            let p: *mut u8 = alloc(cap, 16);
            return Arena { base: p, cap: cap, offset: 0, live: 0 };
        }
    }
    fn release(borrow mut self) {
        unsafe { dealloc(self.base, self.cap, 16); }
    }
}

impl Allocator for Arena {
    fn alloc(borrow mut self, size: usize, align: usize) -> *mut u8 {
        unsafe {
            let start = (self.offset + align - 1) / align * align;
            if start + size > self.cap {
                let zero: usize = 0; return zero as *mut u8;
            }
            self.offset = start + size;
            self.live = self.live + 1;
            return (self.base as usize + start) as *mut u8;
        }
    }
    fn dealloc(borrow mut self, ptr: *mut u8, size: usize) {
        self.live = self.live - 1;
    }
}

struct Big { a: i64, b: i64, name: String }

trait Speak { fn id(borrow self) -> i32; }
struct Dog { n: i32 }
struct Cat { n: i32, tag: String }
impl Speak for Dog { fn id(borrow self) -> i32 { return self.n; } }
impl Speak for Cat { fn id(borrow self) -> i32 { return self.n + 100; } }

fn main() {
    let mut arena = Arena::new(4096);
    {
        let x: Box<Big, Arena> = Box::newIn(Big { a: 1, b: 2, name: String::from("in the arena") }, borrow arena);
        println(x.a + x.b);
        println(x.name);
        let y = Box::newIn(41, borrow arena);
        println(*y + 1);
        let s: Box<dyn Speak, Arena> = Box::newIn(Cat { n: 5, tag: String::from("c") }, borrow arena);
        println(s.id());
        let d: Box<dyn Speak, Arena> = Box::newIn(Dog { n: 7 }, borrow arena);
        println(d.id());
        println(arena.live);
    }
    println(arena.live);
    arena.release();
}
