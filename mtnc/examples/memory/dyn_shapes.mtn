// dyn Trait: fat pointer { data, vtable }; three concrete types, one of which owns heap memory;
// dropping a Box<dyn Trait> runs the concrete type's glue through the vtable.
trait Shape {
    fn area(borrow self) -> i32;
    fn label(borrow self) -> i32;
    fn grow(borrow mut self, by: i32);
}

struct Square { side: i32 }
struct Rect { w: i32, h: i32 }
struct Named { name: String, side: i32 }

impl Shape for Square {
    fn area(borrow self) -> i32 { return self.side * self.side; }
    fn label(borrow self) -> i32 { return 1; }
    fn grow(borrow mut self, by: i32) { self.side = self.side + by; }
}
impl Shape for Rect {
    fn area(borrow self) -> i32 { return self.w * self.h; }
    fn label(borrow self) -> i32 { return 2; }
    fn grow(borrow mut self, by: i32) { self.w = self.w + by; }
}
impl Shape for Named {
    fn area(borrow self) -> i32 { return self.side; }
    fn label(borrow self) -> i32 { return 3; }
    fn grow(borrow mut self, by: i32) { self.side = self.side + by; }
}

struct Holder { shape: Box<dyn Shape>, tag: String }

fn make(kind: i32) -> Box<dyn Shape> {
    if kind == 0 { return Box::new(Square { side: 2 }); }
    if kind == 1 { return Box::new(Rect { w: 2, h: 3 }); }
    return Box::new(Named { name: String::from("named"), side: 7 });
}

fn measure(s: borrow dyn Shape) -> i32 { return s.area() * 10 + s.label(); }

fn bump(s: borrow mut dyn Shape) { s.grow(1); }

fn main() {
    let shapes = [make(0), make(1), make(2)];
    println(shapes[0].area());
    println(shapes[1].area());
    println(shapes[2].area());
    println(measure(borrow shapes[2]));
    let mut b: Box<dyn Shape> = make(2);
    bump(borrow mut b);
    bump(borrow mut b);
    println(b.area());
    let h = Holder { shape: make(1), tag: String::from("holder") };
    println(h.shape.label());
    println(h.tag);
    let o: Option<Box<dyn Shape>> = Some(make(2));
    match o { Some(s) => println(s.label()), None => println(0) }
    let local = Square { side: 5 };
    println(measure(borrow local));
}
