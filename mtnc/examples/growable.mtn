// Phase 11c C2: growable `[T]` and heap `String` handles ({ptr, len, cap}, Doc 13 §1.3).
struct User { name: String, tags: [i32] }

fn sum(a: &[i32]) -> i32 { return a[0] + a[1] + a[2]; }

fn main() {
    let v = [1, 2, 3];
    println(sum(borrow v));
    let u = User { name: "Alice", tags: [7, 8] };
    println(u.name);
    println(u.tags[1]);
}
