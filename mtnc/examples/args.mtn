// Named, default and variadic arguments (Document 10 §2.1-2.3).
fn area(width: i32, height: i32 = 2, scale: i32 = 1) -> i32 {
    width * height * scale
}

fn sum3(...values: i32) -> i32 {
    values[0] + values[1] + values[2]
}

fn weighted(weight: i32, ...values: i32) -> i32 {
    weight * (values[0] + values[1])
}

fn main() {
    println(area(5));
    println(area(5, 3));
    println(area(5, 3, 10));
    println(area(width: 4));
    println(area(scale: 3, width: 4));
    println(area(7, scale: 2));
    println(sum3(1, 2, 3));
    println(weighted(10, 4, 5));
}
