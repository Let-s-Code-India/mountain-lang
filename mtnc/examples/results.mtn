// Option / Result, `?`, `??`, `ensure` (Document 11).
enum MathError {
    DivideByZero,
    Negative,
}

fn safe_div(a: i32, b: i32) -> Result<i32, MathError> {
    ensure(b != 0, MathError::DivideByZero)?;
    Ok(a / b)
}

fn checked_sqrt_like(n: i32) -> Result<i32, MathError> {
    if n < 0 {
        return Err(MathError::Negative);
    }
    Ok(n * n)
}

fn pipeline(a: i32, b: i32) -> Result<i32, MathError> {
    let q = safe_div(a, b)?;
    let s = checked_sqrt_like(q)?;
    Ok(s + 1)
}

fn describe(r: Result<i32, MathError>) -> i32 {
    match r {
        Ok(v) => v,
        Err(MathError::DivideByZero) => -1,
        Err(MathError::Negative) => -2,
    }
}

fn first_even(a: i32, b: i32) -> Option<i32> {
    if a % 2 == 0 {
        Some(a)
    } else if b % 2 == 0 {
        Some(b)
    } else {
        None
    }
}

fn double_first_even(a: i32, b: i32) -> Option<i32> {
    let v = first_even(a, b)?;
    Some(v * 2)
}

fn main() {
    println(describe(pipeline(20, 4)));
    println(describe(pipeline(1, 0)));
    println(describe(pipeline(-20, 4)));
    println(first_even(3, 8) ?? 0);
    println(first_even(3, 5) ?? 99);
    match double_first_even(3, 6) {
        Some(v) => println(v),
        None => println(-1),
    }
    match double_first_even(3, 5) {
        Some(v) => println(v),
        None => println(-1),
    }
}
