// Structs, enums (tagged unions), tuples and `match` (Documents 7, 9).
struct Point {
    x: i32,
    y: i32,
}

enum Shape {
    Circle(i32),
    Rect(i32, i32),
    Empty,
}

enum Color {
    Red,
    Green,
    Blue,
}

fn area(s: Shape) -> i32 {
    match s {
        Shape::Circle(r) => 3 * r * r,
        Shape::Rect(w, h) => w * h,
        Shape::Empty => 0,
    }
}

fn color_code(c: Color) -> i32 {
    match c {
        Color::Red => 1,
        Color::Green => 2,
        Color::Blue => 3,
    }
}

fn classify(n: i32) -> i32 {
    match n {
        0 => 100,
        1 | 2 => 200,
        k if k < 0 => -1,
        _ => 300,
    }
}

fn swap(p: (i32, i32)) -> (i32, i32) {
    let (a, b) = p;
    (b, a)
}

fn main() {
    let mut p = Point { x: 3, y: 4 };
    p.x += 10;
    println(p.x + p.y);
    println(area(Shape::Circle(5)));
    println(area(Shape::Rect(6, 7)));
    println(area(Shape::Empty));
    println(color_code(Color::Blue));
    println(classify(0));
    println(classify(2));
    println(classify(-5));
    println(classify(99));
    let t = swap((1, 2));
    println(t.0);
    println(t.1);
    let pair = (7, 8);
    match pair {
        (0, _) => println(0),
        (a, b) => println(a + b),
    }
}
